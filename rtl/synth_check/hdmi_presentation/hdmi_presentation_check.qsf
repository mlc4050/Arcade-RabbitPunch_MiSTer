set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY rabbitpunch_hdmi_presentation
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 3
set_global_assignment -name SYSTEMVERILOG_FILE ../../../sys/math.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../sys/video_freak.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../video/rotation/screen_rotate_two.sv
set_global_assignment -name VHDL_FILE ../../rabbitpunch_hdmi_rotation.vhd
