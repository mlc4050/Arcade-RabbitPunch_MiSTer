set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY rom_requests_check
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 3
set_global_assignment -name VHDL_FILE ../../rabbitpunch_layout.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_sdram_types.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_rom_requests.vhd
set_global_assignment -name VHDL_FILE rom_requests_check.vhd
set_global_assignment -name SDC_FILE rom_requests_check.sdc
set_location_assignment PIN_V11 -to i_clk
set_instance_assignment -name VIRTUAL_PIN ON -to i_sprite_request
set_instance_assignment -name VIRTUAL_PIN ON -to iu17_sprite_word_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_sprite_response_valid
set_instance_assignment -name VIRTUAL_PIN ON -to ou32_sprite_response_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_tile_request
set_instance_assignment -name VIRTUAL_PIN ON -to iu17_tile_word_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_tile_foreground
set_instance_assignment -name VIRTUAL_PIN ON -to o_tile_response_valid
set_instance_assignment -name VIRTUAL_PIN ON -to ou32_tile_response_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_cpu_request
set_instance_assignment -name VIRTUAL_PIN ON -to iu18_cpu_byte_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_cpu_response_valid
set_instance_assignment -name VIRTUAL_PIN ON -to ou16_cpu_response_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_idle
set_instance_assignment -name VIRTUAL_PIN ON -to ou3_backend_requests[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu3_backend_ready[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou81_backend_byte_addresses[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu3_backend_response_valid[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu192_backend_read_data[*]
