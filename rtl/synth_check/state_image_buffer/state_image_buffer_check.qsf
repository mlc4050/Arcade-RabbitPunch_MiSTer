set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY state_image_buffer_check
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 3
set_global_assignment -name VHDL_FILE ../../state/rabbitpunch_state_image_buffer.vhd
set_global_assignment -name VHDL_FILE state_image_buffer_check.vhd
set_global_assignment -name SDC_FILE state_image_buffer_check.sdc
set_location_assignment PIN_V11 -to i_clk
set_instance_assignment -name VIRTUAL_PIN ON -to i_initialize
set_instance_assignment -name VIRTUAL_PIN ON -to i_begin
set_instance_assignment -name VIRTUAL_PIN ON -to i_cancel
set_instance_assignment -name VIRTUAL_PIN ON -to i_fill_valid
set_instance_assignment -name VIRTUAL_PIN ON -to o_fill_ready
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_fill_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_seal
set_instance_assignment -name VIRTUAL_PIN ON -to o_sealed
set_instance_assignment -name VIRTUAL_PIN ON -to o_error
set_instance_assignment -name VIRTUAL_PIN ON -to ou18_filled_bytes[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_read_valid
set_instance_assignment -name VIRTUAL_PIN ON -to iu18_read_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_read_response
set_instance_assignment -name VIRTUAL_PIN ON -to o_read_error
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_read_data[*]
