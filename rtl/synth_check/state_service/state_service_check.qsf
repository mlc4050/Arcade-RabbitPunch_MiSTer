set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY state_service_check
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 3
set_global_assignment -name VHDL_FILE ../../state/rabbitpunch_state_layout.vhd
set_global_assignment -name VHDL_FILE ../../state/rabbitpunch_state_crc.vhd
set_global_assignment -name VHDL_FILE ../../state/rabbitpunch_state_header.vhd
set_global_assignment -name VHDL_FILE ../../state/rabbitpunch_state_preflight.vhd
set_global_assignment -name VHDL_FILE ../../state/rabbitpunch_state_semantics.vhd
set_global_assignment -name VHDL_FILE ../../state/rabbitpunch_state_image_buffer.vhd
set_global_assignment -name VHDL_FILE ../../state/rabbitpunch_state_snapshot.vhd
set_global_assignment -name VHDL_FILE ../../state/rabbitpunch_state_slot_reader.vhd
set_global_assignment -name VHDL_FILE ../../state/rabbitpunch_state_image_validator.vhd
set_global_assignment -name VHDL_FILE ../../state/rabbitpunch_state_apply.vhd
set_global_assignment -name VHDL_FILE ../../state/rabbitpunch_state_image_words.vhd
set_global_assignment -name VHDL_FILE ../../state/rabbitpunch_state_slot_writer.vhd
set_global_assignment -name VHDL_FILE ../../state/rabbitpunch_state_publish.vhd
set_global_assignment -name VHDL_FILE ../../state/rabbitpunch_state_service.vhd
set_global_assignment -name VHDL_FILE state_service_check.vhd
set_global_assignment -name SDC_FILE state_service_check.sdc
set_location_assignment PIN_V11 -to i_clk
set_instance_assignment -name VIRTUAL_PIN ON -to i_initialize
set_instance_assignment -name VIRTUAL_PIN ON -to i_game_reset_completed
set_instance_assignment -name VIRTUAL_PIN ON -to i_save
set_instance_assignment -name VIRTUAL_PIN ON -to i_restore
set_instance_assignment -name VIRTUAL_PIN ON -to i_cancel
set_instance_assignment -name VIRTUAL_PIN ON -to iu2_slot[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_rom_identity_valid
set_instance_assignment -name VIRTUAL_PIN ON -to iu32_abi_signature[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu32_rom_identity[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu32_config_identity[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_ready
set_instance_assignment -name VIRTUAL_PIN ON -to o_busy
set_instance_assignment -name VIRTUAL_PIN ON -to o_finished
set_instance_assignment -name VIRTUAL_PIN ON -to o_success
set_instance_assignment -name VIRTUAL_PIN ON -to o_restoring
set_instance_assignment -name VIRTUAL_PIN ON -to o_incomplete
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_error[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_machine_ready
set_instance_assignment -name VIRTUAL_PIN ON -to i_machine_busy
set_instance_assignment -name VIRTUAL_PIN ON -to i_machine_held
set_instance_assignment -name VIRTUAL_PIN ON -to i_machine_finished
set_instance_assignment -name VIRTUAL_PIN ON -to iu4_machine_error[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_machine_acquire
set_instance_assignment -name VIRTUAL_PIN ON -to o_machine_cancel
set_instance_assignment -name VIRTUAL_PIN ON -to o_machine_release
set_instance_assignment -name VIRTUAL_PIN ON -to o_body_apply_begin
set_instance_assignment -name VIRTUAL_PIN ON -to o_body_request
set_instance_assignment -name VIRTUAL_PIN ON -to i_body_ready
set_instance_assignment -name VIRTUAL_PIN ON -to o_body_write
set_instance_assignment -name VIRTUAL_PIN ON -to ou18_body_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_body_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_body_response
set_instance_assignment -name VIRTUAL_PIN ON -to i_body_error
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_body_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_body_commit
set_instance_assignment -name VIRTUAL_PIN ON -to i_body_committed
set_instance_assignment -name VIRTUAL_PIN ON -to i_body_commit_error
set_instance_assignment -name VIRTUAL_PIN ON -to o_ddr_read
set_instance_assignment -name VIRTUAL_PIN ON -to o_ddr_write
set_instance_assignment -name VIRTUAL_PIN ON -to ou29_ddr_word_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou64_ddr_write_data[*]
