set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY state_scanout_check
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 3
set_global_assignment -name VHDL_FILE ../../rabbitpunch_clock_enables.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_raster.vhd
set_global_assignment -name VHDL_FILE ../../state/rabbitpunch_state_game_timing.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_scanline_scheduler.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_video_output.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_scanout.vhd
set_global_assignment -name VHDL_FILE state_scanout_check.vhd
set_global_assignment -name SDC_FILE state_scanout_check.sdc
set_location_assignment PIN_V11 -to i_clk
set_instance_assignment -name VIRTUAL_PIN ON -to i_initialize
set_instance_assignment -name VIRTUAL_PIN ON -to i_game_ready
set_instance_assignment -name VIRTUAL_PIN ON -to o_main_phase_enable
set_instance_assignment -name VIRTUAL_PIN ON -to o_sound_cpu_enable
set_instance_assignment -name VIRTUAL_PIN ON -to o_ym_enable
set_instance_assignment -name VIRTUAL_PIN ON -to o_ym_half_enable
set_instance_assignment -name VIRTUAL_PIN ON -to o_adpcm_enable
set_instance_assignment -name VIRTUAL_PIN ON -to o_vblank_start
set_instance_assignment -name VIRTUAL_PIN ON -to o_half_frame
set_instance_assignment -name VIRTUAL_PIN ON -to o_line_valid
set_instance_assignment -name VIRTUAL_PIN ON -to i_line_ready
set_instance_assignment -name VIRTUAL_PIN ON -to o_render_bank
set_instance_assignment -name VIRTUAL_PIN ON -to ou9_line_y[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_line_done
set_instance_assignment -name VIRTUAL_PIN ON -to o_pixel_valid
set_instance_assignment -name VIRTUAL_PIN ON -to i_pixel_ready
set_instance_assignment -name VIRTUAL_PIN ON -to o_pixel_bank
set_instance_assignment -name VIRTUAL_PIN ON -to ou9_pixel_x[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_pixel_y[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_rgb_valid
set_instance_assignment -name VIRTUAL_PIN ON -to i_rgb_error
set_instance_assignment -name VIRTUAL_PIN ON -to iu9_rgb_x[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_rgb_y[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_red[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_green[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_blue[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_pixel_enable
set_instance_assignment -name VIRTUAL_PIN ON -to o_active
set_instance_assignment -name VIRTUAL_PIN ON -to o_hsync
set_instance_assignment -name VIRTUAL_PIN ON -to o_vsync
set_instance_assignment -name VIRTUAL_PIN ON -to o_hblank
set_instance_assignment -name VIRTUAL_PIN ON -to o_vblank
set_instance_assignment -name VIRTUAL_PIN ON -to ou9_output_x[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_output_y[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_red[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_green[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_blue[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou9_horizontal_position[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou9_vertical_position[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_armed
set_instance_assignment -name VIRTUAL_PIN ON -to o_underflow
set_instance_assignment -name VIRTUAL_PIN ON -to i_state_hold
set_instance_assignment -name VIRTUAL_PIN ON -to i_state_load
set_instance_assignment -name VIRTUAL_PIN ON -to iu32_state_cadence[*]
