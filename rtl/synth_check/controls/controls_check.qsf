set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY rabbitpunch_controls
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 3
set_global_assignment -name SYSTEMVERILOG_FILE ../../mame_keys.sv
set_global_assignment -name VHDL_FILE ../../rabbitpunch_keys.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_inputs.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_pause.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_controls.vhd
set_global_assignment -name SDC_FILE controls_check.sdc
set_location_assignment PIN_V11 -to i_clk
set_instance_assignment -name VIRTUAL_PIN ON -to i_initialize
set_instance_assignment -name VIRTUAL_PIN ON -to i_game_reset
set_instance_assignment -name VIRTUAL_PIN ON -to i_osd_open
set_instance_assignment -name VIRTUAL_PIN ON -to i_pause_on_osd
set_instance_assignment -name VIRTUAL_PIN ON -to i_debug_pause
set_instance_assignment -name VIRTUAL_PIN ON -to i_state_pause
set_instance_assignment -name VIRTUAL_PIN ON -to iu32_joystick0[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu32_joystick1[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu11_key_event[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_file_write
set_instance_assignment -name VIRTUAL_PIN ON -to iu16_file_index[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu27_file_byte_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_file_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_player1[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_player2[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_service[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou16_dips[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_pause_request
set_instance_assignment -name VIRTUAL_PIN ON -to o_user_paused
