set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY rabbitpunch_audio_mixer
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 3
set_global_assignment -name VHDL_FILE ../../rabbitpunch_audio_mixer.vhd
set_global_assignment -name SDC_FILE audio_mixer_check.sdc
set_location_assignment PIN_V11 -to i_clk
set_instance_assignment -name VIRTUAL_PIN ON -to i_reset
set_instance_assignment -name VIRTUAL_PIN ON -to iu16_left_pcm[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu16_right_pcm[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu9_adpcm_pcm[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou16_mono_pcm[*]
