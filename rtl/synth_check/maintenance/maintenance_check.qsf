set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY rabbitpunch_maintenance
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 3
set_global_assignment -name VHDL_FILE ../../rabbitpunch_maintenance.vhd
set_global_assignment -name SDC_FILE maintenance_check.sdc
set_location_assignment PIN_V11 -to i_clk
set_instance_assignment -name VIRTUAL_PIN ON -to i_initialize
set_instance_assignment -name VIRTUAL_PIN ON -to i_access_requested
set_instance_assignment -name VIRTUAL_PIN ON -to o_pause
set_instance_assignment -name VIRTUAL_PIN ON -to i_cpu_paused
set_instance_assignment -name VIRTUAL_PIN ON -to i_bus_idle
set_instance_assignment -name VIRTUAL_PIN ON -to i_byte_valid
set_instance_assignment -name VIRTUAL_PIN ON -to o_byte_ready
set_instance_assignment -name VIRTUAL_PIN ON -to i_byte_write
set_instance_assignment -name VIRTUAL_PIN ON -to iu14_byte_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_byte_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_byte_response_valid
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_byte_response_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_idle
set_instance_assignment -name VIRTUAL_PIN ON -to o_bus_request
set_instance_assignment -name VIRTUAL_PIN ON -to o_bus_write
set_instance_assignment -name VIRTUAL_PIN ON -to ou24_bus_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou16_bus_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou2_bus_bytes[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_bus_response_valid
set_instance_assignment -name VIRTUAL_PIN ON -to iu16_bus_response_data[*]
