set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY priority_check
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 1
set_global_assignment -name VHDL_FILE ../../rabbitpunch_sprite_priority.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_pixel_mixer.vhd
set_global_assignment -name VHDL_FILE priority_check.vhd
set_global_assignment -name SDC_FILE priority_check.sdc
set_location_assignment PIN_V11 -to i_clk
set_instance_assignment -name VIRTUAL_PIN ON -to i_occupied
set_instance_assignment -name VIRTUAL_PIN ON -to iu6_stored_index[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_stored_palette[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_stored_behind_foreground
set_instance_assignment -name VIRTUAL_PIN ON -to i_candidate_valid
set_instance_assignment -name VIRTUAL_PIN ON -to iu6_candidate_index[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_candidate_palette[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_candidate_behind_foreground
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_background[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_foreground[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_bitmap[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_write
set_instance_assignment -name VIRTUAL_PIN ON -to o_occupied
set_instance_assignment -name VIRTUAL_PIN ON -to ou6_winner_index[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_winner_palette[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_winner_behind_foreground
set_instance_assignment -name VIRTUAL_PIN ON -to ou10_palette_index[*]
