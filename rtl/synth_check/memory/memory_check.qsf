set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY rabbitpunch_memory
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 1
set_global_assignment -name VHDL_FILE ../../rabbitpunch_layout.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_decode.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_ram16.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_board_memory.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_memory.vhd
set_global_assignment -name SDC_FILE memory_check.sdc
# Virtual I/O keeps the block visible without requiring a complete MiSTer pinout.
# The sole physical clock pin matches sys/sys.tcl; no bitstream is deployed.
set_instance_assignment -name VIRTUAL_PIN ON -to i_request
set_instance_assignment -name VIRTUAL_PIN ON -to i_request_write
set_instance_assignment -name VIRTUAL_PIN ON -to iu24_request_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu16_request_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu2_request_bytes[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_request_supported
set_instance_assignment -name VIRTUAL_PIN ON -to o_response_valid
set_instance_assignment -name VIRTUAL_PIN ON -to ou16_response_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_rom_request
set_instance_assignment -name VIRTUAL_PIN ON -to ou18_rom_byte_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_rom_response_valid
set_instance_assignment -name VIRTUAL_PIN ON -to iu16_rom_response_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_view_enable
set_instance_assignment -name VIRTUAL_PIN ON -to iu5_view_target[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu15_view_word_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_view_valid
set_instance_assignment -name VIRTUAL_PIN ON -to ou16_view_data[*]
set_location_assignment PIN_V11 -to i_clk
