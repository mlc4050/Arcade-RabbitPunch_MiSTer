set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY rabbitpunch_memory
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 1
set_global_assignment -name VHDL_FILE ../../rabbitpunch_layout.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_decode.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_ram16.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_memory.vhd
set_global_assignment -name SDC_FILE memory_check.sdc
# Virtual I/O keeps the block visible without requiring a complete MiSTer pinout.
# The sole physical clock pin matches sys/sys.tcl; no bitstream is deployed.
set_instance_assignment -name VIRTUAL_PIN ON -to *
set_instance_assignment -name VIRTUAL_PIN OFF -to i_clk
set_location_assignment PIN_V11 -to i_clk
