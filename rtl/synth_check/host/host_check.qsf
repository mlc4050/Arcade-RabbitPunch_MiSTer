set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY host_check
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 3
set_global_assignment -name SYSTEMVERILOG_FILE ../../../sys/hps_io.sv
set_global_assignment -name VHDL_FILE ../../rabbitpunch_host.vhd
set_global_assignment -name VHDL_FILE host_check.vhd
set_global_assignment -name SDC_FILE host_check.sdc
set_location_assignment PIN_V11 -to i_clk
set_instance_assignment -name VIRTUAL_PIN ON -to iu16_host_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_host_strobe
set_instance_assignment -name VIRTUAL_PIN ON -to i_uio_select
set_instance_assignment -name VIRTUAL_PIN ON -to i_file_select
set_instance_assignment -name VIRTUAL_PIN ON -to ou16_host_response[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_host_wait
set_instance_assignment -name VIRTUAL_PIN ON -to o_wide_mode
set_instance_assignment -name VIRTUAL_PIN ON -to iu16_menu_mask[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou128_status[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou32_joystick0[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou32_joystick1[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou11_key_event[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou2_buttons[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_forced_scandoubler
set_instance_assignment -name VIRTUAL_PIN ON -to o_direct_video
set_instance_assignment -name VIRTUAL_PIN ON -to ou16_sdram_configuration[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_file_download
set_instance_assignment -name VIRTUAL_PIN ON -to ou16_file_index[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_file_write
set_instance_assignment -name VIRTUAL_PIN ON -to ou27_file_byte_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_file_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_file_wait
