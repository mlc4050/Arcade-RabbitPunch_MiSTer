set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY rabbitpunch_ddr_write_queue
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 3
set_global_assignment -name VHDL_FILE ../../rabbitpunch_ddr_write_queue.vhd
set_global_assignment -name SDC_FILE ddr_write_queue_check.sdc
set_location_assignment PIN_V11 -to i_clk
set_instance_assignment -name VIRTUAL_PIN ON -to i_initialize
set_instance_assignment -name VIRTUAL_PIN ON -to i_write
set_instance_assignment -name VIRTUAL_PIN ON -to iu29_word_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu64_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_byte_enables[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_full
set_instance_assignment -name VIRTUAL_PIN ON -to o_empty
set_instance_assignment -name VIRTUAL_PIN ON -to o_overflow
set_instance_assignment -name VIRTUAL_PIN ON -to i_ddr_busy
set_instance_assignment -name VIRTUAL_PIN ON -to o_ddr_write
set_instance_assignment -name VIRTUAL_PIN ON -to ou29_ddr_word_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou64_ddr_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_ddr_byte_enables[*]
