set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY raster_check
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 3
set_global_assignment -name VHDL_FILE ../../rabbitpunch_clock_enables.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_raster.vhd
set_global_assignment -name VHDL_FILE raster_check.vhd
set_global_assignment -name SDC_FILE raster_check.sdc
set_location_assignment PIN_V11 -to i_clk
set_instance_assignment -name VIRTUAL_PIN ON -to i_reset
set_instance_assignment -name VIRTUAL_PIN ON -to ou9_horizontal_position[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou9_vertical_position[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou9_pixel_x[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_pixel_y[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_active
set_instance_assignment -name VIRTUAL_PIN ON -to o_hsync
set_instance_assignment -name VIRTUAL_PIN ON -to o_vsync
set_instance_assignment -name VIRTUAL_PIN ON -to o_hblank
set_instance_assignment -name VIRTUAL_PIN ON -to o_vblank
set_instance_assignment -name VIRTUAL_PIN ON -to o_line_start
set_instance_assignment -name VIRTUAL_PIN ON -to o_visible_line_start
set_instance_assignment -name VIRTUAL_PIN ON -to o_frame_start
set_instance_assignment -name VIRTUAL_PIN ON -to o_vblank_start
set_instance_assignment -name VIRTUAL_PIN ON -to o_half_frame
set_instance_assignment -name VIRTUAL_PIN ON -to o_pixel_enable
set_instance_assignment -name VIRTUAL_PIN ON -to o_main_phase_enable
set_instance_assignment -name VIRTUAL_PIN ON -to o_sound_cpu_enable
set_instance_assignment -name VIRTUAL_PIN ON -to o_ym_enable
set_instance_assignment -name VIRTUAL_PIN ON -to o_ym_half_enable
set_instance_assignment -name VIRTUAL_PIN ON -to o_adpcm_enable
