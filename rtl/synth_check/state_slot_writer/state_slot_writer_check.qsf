set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY state_slot_writer_check
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 3
set_global_assignment -name VHDL_FILE ../../state/rabbitpunch_state_slot_writer.vhd
set_global_assignment -name VHDL_FILE state_slot_writer_check.vhd
set_global_assignment -name SDC_FILE state_slot_writer_check.sdc
set_location_assignment PIN_V11 -to i_clk
set_instance_assignment -name VIRTUAL_PIN ON -to i_initialize
set_instance_assignment -name VIRTUAL_PIN ON -to i_start
set_instance_assignment -name VIRTUAL_PIN ON -to i_cancel
set_instance_assignment -name VIRTUAL_PIN ON -to iu2_slot[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_payload_valid
set_instance_assignment -name VIRTUAL_PIN ON -to o_payload_ready
set_instance_assignment -name VIRTUAL_PIN ON -to iu64_payload_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_active
set_instance_assignment -name VIRTUAL_PIN ON -to o_finished
set_instance_assignment -name VIRTUAL_PIN ON -to o_success
set_instance_assignment -name VIRTUAL_PIN ON -to o_error
set_instance_assignment -name VIRTUAL_PIN ON -to o_ddr_read
set_instance_assignment -name VIRTUAL_PIN ON -to o_ddr_write
set_instance_assignment -name VIRTUAL_PIN ON -to ou29_ddr_word_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou64_ddr_write_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_ddr_busy
set_instance_assignment -name VIRTUAL_PIN ON -to i_ddr_read_valid
set_instance_assignment -name VIRTUAL_PIN ON -to iu64_ddr_read_data[*]
