set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY adpcm_check
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 3
set_global_assignment -name VERILOG_FILE ../../sound/jt7759/hdl/jt7759.v
set_global_assignment -name VERILOG_FILE ../../sound/jt7759/hdl/jt7759_adpcm.v
set_global_assignment -name VERILOG_FILE ../../sound/jt7759/hdl/jt7759_ctrl.v
set_global_assignment -name VERILOG_FILE ../../sound/jt7759/hdl/jt7759_data.v
set_global_assignment -name VERILOG_FILE ../../sound/jt7759/hdl/jt7759_div.v
set_global_assignment -name VHDL_FILE ../../rabbitpunch_upd7759.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_adpcm.vhd
set_global_assignment -name VHDL_FILE adpcm_check.vhd
set_global_assignment -name SDC_FILE adpcm_check.sdc
set_location_assignment PIN_V11 -to i_clk
set_instance_assignment -name VIRTUAL_PIN ON -to i_reset
set_instance_assignment -name VIRTUAL_PIN ON -to i_enable
set_instance_assignment -name VIRTUAL_PIN ON -to i_control_write
set_instance_assignment -name VIRTUAL_PIN ON -to i_command_write
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_write_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_busy
set_instance_assignment -name VIRTUAL_PIN ON -to o_rom_request
set_instance_assignment -name VIRTUAL_PIN ON -to ou18_rom_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_rom_valid
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_rom_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou9_pcm[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_bank
set_instance_assignment -name VIRTUAL_PIN ON -to o_reset_asserted
