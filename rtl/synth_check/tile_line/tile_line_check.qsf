set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY rabbitpunch_tiles
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 1
set_global_assignment -name VHDL_FILE ../../rabbitpunch_ram16.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_tile_row.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_tile_lookup.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_tile_layer.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_tiles.vhd
set_global_assignment -name SYSTEMVERILOG_FILE ../../jtframe/jtframe_draw.v
set_global_assignment -name SDC_FILE tile_line_check.sdc
set_location_assignment PIN_V11 -to i_clk
set_instance_assignment -name VIRTUAL_PIN ON -to i_reset
set_instance_assignment -name VIRTUAL_PIN ON -to i_line_valid
set_instance_assignment -name VIRTUAL_PIN ON -to o_line_ready
set_instance_assignment -name VIRTUAL_PIN ON -to i_render_bank
set_instance_assignment -name VIRTUAL_PIN ON -to iu9_line_y[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu9_background_scroll_x[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu9_background_scroll_y[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu9_foreground_scroll_x[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu9_foreground_scroll_y[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu16_video_flags[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_line_done
set_instance_assignment -name VIRTUAL_PIN ON -to o_ram_request
set_instance_assignment -name VIRTUAL_PIN ON -to ou13_ram_word_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_ram_response_valid
set_instance_assignment -name VIRTUAL_PIN ON -to iu16_ram_response_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_rom_request
set_instance_assignment -name VIRTUAL_PIN ON -to ou17_rom_word_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_rom_foreground
set_instance_assignment -name VIRTUAL_PIN ON -to i_rom_response_valid
set_instance_assignment -name VIRTUAL_PIN ON -to iu32_rom_response_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_view_enable
set_instance_assignment -name VIRTUAL_PIN ON -to o_view_ready
set_instance_assignment -name VIRTUAL_PIN ON -to i_view_bank
set_instance_assignment -name VIRTUAL_PIN ON -to iu9_view_x[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_view_valid
set_instance_assignment -name VIRTUAL_PIN ON -to ou9_view_line_y[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou16_view_pixels[*]
