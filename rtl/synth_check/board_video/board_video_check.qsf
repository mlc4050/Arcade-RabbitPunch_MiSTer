set_instance_assignment -name VIRTUAL_PIN ON -to o_sprite_rom_request
set_instance_assignment -name VIRTUAL_PIN ON -to ou17_sprite_rom_word_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_sprite_rom_response_valid
set_instance_assignment -name VIRTUAL_PIN ON -to iu32_sprite_rom_response_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_tile_rom_request
