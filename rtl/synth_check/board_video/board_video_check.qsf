set_instance_assignment -name VIRTUAL_PIN ON -to ou18_rom_byte_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_rom_response_valid
set_instance_assignment -name VIRTUAL_PIN ON -to iu16_rom_response_data[*]
