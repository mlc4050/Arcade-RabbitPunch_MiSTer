set_instance_assignment -name VIRTUAL_PIN ON -to iu32_tile_rom_response_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_pixel_valid
set_instance_assignment -name VIRTUAL_PIN ON -to o_pixel_ready
set_instance_assignment -name VIRTUAL_PIN ON -to i_pixel_bank
set_instance_assignment -name VIRTUAL_PIN ON -to iu9_pixel_x[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_pixel_y[*]
