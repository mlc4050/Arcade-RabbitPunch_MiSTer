set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY jt7759_state_check
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 3
set_global_assignment -name VHDL_FILE ../../state/generated/jt7759_state_netlist.vhd
set_global_assignment -name VHDL_FILE jt7759_state_check.vhd
set_global_assignment -name SDC_FILE jt7759_state_check.sdc
set_location_assignment PIN_V11 -to i_clk
set_instance_assignment -name VIRTUAL_PIN ON -to i_reset
set_instance_assignment -name VIRTUAL_PIN ON -to i_chip_enable
set_instance_assignment -name VIRTUAL_PIN ON -to i_start_n
set_instance_assignment -name VIRTUAL_PIN ON -to i_chip_select
set_instance_assignment -name VIRTUAL_PIN ON -to i_standalone_mode
set_instance_assignment -name VIRTUAL_PIN ON -to o_busy_n
set_instance_assignment -name VIRTUAL_PIN ON -to i_write_n
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_write_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_data_request_n
set_instance_assignment -name VIRTUAL_PIN ON -to o_rom_request
set_instance_assignment -name VIRTUAL_PIN ON -to ou17_rom_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_rom_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_rom_valid
set_instance_assignment -name VIRTUAL_PIN ON -to ou9_pcm[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_state_hold
set_instance_assignment -name VIRTUAL_PIN ON -to i_state_write
set_instance_assignment -name VIRTUAL_PIN ON -to iu16_state_word_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu32_state_write_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou32_state_read_data[*]
