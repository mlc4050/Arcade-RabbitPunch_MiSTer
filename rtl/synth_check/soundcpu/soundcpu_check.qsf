set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY soundcpu_check
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 3
set_global_assignment -name VHDL_FILE ../../cpu/t80/T80_Pack.vhd
set_global_assignment -name VHDL_FILE ../../cpu/t80/T80_Reg.vhd
set_global_assignment -name VHDL_FILE ../../cpu/t80/T80_MCode.vhd
set_global_assignment -name VHDL_FILE ../../cpu/t80/T80_ALU.vhd
set_global_assignment -name VHDL_FILE ../../cpu/t80/T80.vhd
set_global_assignment -name VHDL_FILE ../../cpu/t80/T80se.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_z80.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_soundcpu.vhd
set_global_assignment -name VHDL_FILE soundcpu_check.vhd
set_global_assignment -name SDC_FILE soundcpu_check.sdc
set_location_assignment PIN_V11 -to i_clk
set_instance_assignment -name VIRTUAL_PIN ON -to i_reset
set_instance_assignment -name VIRTUAL_PIN ON -to i_enable
set_instance_assignment -name VIRTUAL_PIN ON -to i_pause
set_instance_assignment -name VIRTUAL_PIN ON -to i_interrupt
set_instance_assignment -name VIRTUAL_PIN ON -to o_request
set_instance_assignment -name VIRTUAL_PIN ON -to o_request_write
set_instance_assignment -name VIRTUAL_PIN ON -to ou16_request_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_request_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_response_valid
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_response_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_paused
set_instance_assignment -name VIRTUAL_PIN ON -to o_halted
