set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY rabbitpunch_rotation_transport
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 3
set_global_assignment -name VHDL_FILE ../../rabbitpunch_ddr_write_queue.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_frame_publication.vhd
set_global_assignment -name VHDL_FILE ../../rabbitpunch_rotation_transport.vhd
set_global_assignment -name SDC_FILE rotation_transport_check.sdc
set_location_assignment PIN_V11 -to i_clk
set_instance_assignment -name VIRTUAL_PIN ON -to i_initialize
set_instance_assignment -name VIRTUAL_PIN ON -to i_enable
set_instance_assignment -name VIRTUAL_PIN ON -to i_game_ready
set_instance_assignment -name VIRTUAL_PIN ON -to i_loader_active
set_instance_assignment -name VIRTUAL_PIN ON -to i_vertical_sync
set_instance_assignment -name VIRTUAL_PIN ON -to i_donor_enabled
set_instance_assignment -name VIRTUAL_PIN ON -to i_pixel_write
set_instance_assignment -name VIRTUAL_PIN ON -to iu29_pixel_word_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu64_pixel_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_pixel_byte_enables[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu2_framebuffer_read_slot[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_framebuffer_valid
set_instance_assignment -name VIRTUAL_PIN ON -to o_discard_frame
set_instance_assignment -name VIRTUAL_PIN ON -to o_queue_empty
set_instance_assignment -name VIRTUAL_PIN ON -to o_queue_overflow
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_loader_burst_count[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu29_loader_word_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu64_loader_write_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to iu8_loader_byte_enables[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_loader_read
set_instance_assignment -name VIRTUAL_PIN ON -to i_loader_write
set_instance_assignment -name VIRTUAL_PIN ON -to o_loader_busy
set_instance_assignment -name VIRTUAL_PIN ON -to o_loader_read_valid
set_instance_assignment -name VIRTUAL_PIN ON -to ou64_loader_read_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to i_ddr_busy
set_instance_assignment -name VIRTUAL_PIN ON -to i_ddr_read_valid
set_instance_assignment -name VIRTUAL_PIN ON -to iu64_ddr_read_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_ddr_burst_count[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou29_ddr_word_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou64_ddr_write_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ou8_ddr_byte_enables[*]
set_instance_assignment -name VIRTUAL_PIN ON -to o_ddr_read
set_instance_assignment -name VIRTUAL_PIN ON -to o_ddr_write
