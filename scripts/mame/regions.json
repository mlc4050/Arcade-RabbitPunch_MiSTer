{
  "_comment": "Rabbit Punch / Rabio Lepus. Inclusive CPU byte addresses. Video registers are write-only; reconstruct their state from taps.",
  "cpu": ":maincpu", "space": "program", "bus_bytes": 2, "big_endian": true,
  "read": {
    "bitmap": ["0x040000", "0x04ffff"],
    "spriteram": ["0x060000", "0x060fff"],
    "videoram": ["0x080000", "0x083fff"],
    "palette": ["0x0a0000", "0x0a07ff"],
    "workram": ["0x0fc000", "0x0fffff"]
  },
  "wtap": {
    "bitmap": ["0x040000", "0x04ffff"],
    "spriteram": ["0x060000", "0x060fff"],
    "videoram": ["0x080000", "0x083fff"],
    "palette": ["0x0a0000", "0x0a07ff"],
    "vregs": ["0x0c0000", "0x0c0029"]
  },
  "sweep": ["bitmap", "spriteram", "videoram", "palette", "vregs"],
  "_sweep_fields_format": "region, first byte, last byte, stride bytes, offset within stride, write mask. Sprite fields cover the 64 descriptor slots selected by the 6-bit count register.",
  "sweep_fields": {
    "sprite_y": ["spriteram", "0x0", "0x1ff", 8, 0, "0x01ff"],
    "sprite_code": ["spriteram", "0x0", "0x1ff", 8, 2, "0x07ff"],
    "sprite_flip": ["spriteram", "0x0", "0x1ff", 8, 2, "0x1800"],
    "sprite_color": ["spriteram", "0x0", "0x1ff", 8, 2, "0xe000"],
    "sprite_x": ["spriteram", "0x0", "0x1ff", 8, 4, "0x01ff"],
    "sprite_unused": ["spriteram", "0x0", "0x1ff", 8, 6, "0xffff"],
    "tile_bg0": ["videoram", "0x0", "0x1fff", 2, 0, "0xffff"],
    "tile_bg1": ["videoram", "0x2000", "0x3fff", 2, 0, "0xffff"],
    "scroll_bg0_y": ["vregs", "0x0", "0x1", 2, 0, "0xffff"],
    "scroll_bg0_x": ["vregs", "0x2", "0x3", 2, 0, "0xffff"],
    "scroll_bg1_y": ["vregs", "0x4", "0x5", 2, 0, "0xffff"],
    "scroll_bg1_x": ["vregs", "0x6", "0x7", 2, 0, "0xffff"],
    "video_flags": ["vregs", "0xc", "0xd", 2, 0, "0xffff"],
    "sprite_count": ["vregs", "0x10", "0x11", 2, 0, "0x00ff"],
    "sprite_priority": ["vregs", "0x12", "0x13", 2, 0, "0x00ff"]
  },
  "trace": {
    "addr_hi": "0x0fffff", "io": ["0x0c0000", "0x0c0029"],
    "vectors": ["0x000000", "0x0000ff"],
    "ipl": {"reg": "SR", "shift": 8, "mask": 7},
    "rom": [["0x000000", "0x03ffff"]],
    "ram": [["0x040000", "0x04ffff"], ["0x060000", "0x060fff"], ["0x080000", "0x083fff"], ["0x0a0000", "0x0a07ff"], ["0x0fc000", "0x0fffff"]]
  },
  "inputs": {"coin": "Coin 1", "start": "1 Player Start", "hold": "P1 Right", "pulse": "P1 Button 1"}
}
